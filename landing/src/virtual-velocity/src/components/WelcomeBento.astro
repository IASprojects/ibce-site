---
import { getTranslations } from '../i18n/ui';

const t = getTranslations(Astro.currentLocale ?? 'es');

const cards = [
	{
		icon: 'waving_hand',
		iconWrap: 'bg-secondary-container text-on-secondary-fixed-variant',
		title: t['welcome.card1.title'],
		subtitle: t['welcome.card1.subtitle'],
		body: t['welcome.card1.body'],
	},
	{
		icon: 'family_restroom',
		iconWrap: 'bg-tertiary-fixed text-on-tertiary-fixed',
		title: t['welcome.card2.title'],
		subtitle: t['welcome.card2.subtitle'],
		body: t['welcome.card2.body'],
	},
	{
		icon: 'menu_book',
		iconWrap: 'bg-primary-fixed text-on-primary-fixed',
		title: t['welcome.card3.title'],
		subtitle: t['welcome.card3.subtitle'],
		body: t['welcome.card3.body'],
	},
];
---

<section id="bienvenida" aria-labelledby="welcome-heading" class="mb-section-gap">
	<div class="mb-8 max-w-2xl">
		<p class="mb-2 font-label-caps text-label-caps text-secondary">{t['welcome.eyebrow']}</p>
		<h2 id="welcome-heading" class="font-headline-md text-headline-md text-on-surface sm:text-[30px] sm:leading-[38px]">
			{t['welcome.heading']}
		</h2>
		<p class="mt-3 text-on-surface-variant">{t['welcome.paragraph']}</p>
	</div>
	<div class="grid grid-cols-1 gap-4 md:grid-cols-3 md:gap-5">
		{cards.map((card) => (
			<article class="rounded-xl border border-outline-variant/50 bg-surface-container-low p-6 transition-colors hover:bg-surface-container sm:p-7">
				<div class={`mb-5 flex h-12 w-12 items-center justify-center rounded-full ${card.iconWrap}`}>
					<span class="material-symbols-outlined text-2xl" aria-hidden="true" data-icon={card.icon}>{card.icon}</span>
				</div>
				<p class="mb-2 font-label-caps text-label-caps text-primary">{card.subtitle}</p>
				<h3 class="mb-3 font-headline-md text-[20px] leading-7 text-on-surface">{card.title}</h3>
				<p class="text-on-surface-variant">{card.body}</p>
			</article>
		))}
	</div>
</section>
