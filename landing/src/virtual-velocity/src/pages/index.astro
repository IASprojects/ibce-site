---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import WelcomeBento from '../components/WelcomeBento.astro';
import BottomNav from '../components/BottomNav.astro';
import Footer from '../components/Footer.astro';
import { getTranslations } from '../i18n/ui';

const t = getTranslations('es');
---

<Layout title={t['meta.title']} description={t['meta.description']}>
	<Header />
	<main class="pt-20 md:pt-24 max-w-container-max mx-auto px-4 md:px-gutter">
		<Hero />
		<WelcomeBento />
	</main>
	<BottomNav />
	<Footer />
</Layout>