---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Volunteer from '../../components/Volunteer.astro';
import BottomNav from '../../components/BottomNav.astro';
import Footer from '../../components/Footer.astro';
import { getTranslations } from '../../i18n/ui';

const t = getTranslations(Astro.currentLocale ?? 'es');
---

<Layout title={t['voluntariado.title']} description={t['voluntariado.subtitle']}>
	<Header />
	<main class="pt-20 md:pt-24 max-w-container-max mx-auto px-4 md:px-gutter">
		<Volunteer />
	</main>
	<BottomNav />
	<Footer />
</Layout>