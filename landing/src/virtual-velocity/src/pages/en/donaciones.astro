---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Donate from '../../components/Donate.astro';
import BottomNav from '../../components/BottomNav.astro';
import Footer from '../../components/Footer.astro';
import { getTranslations } from '../../i18n/ui';

const t = getTranslations(Astro.currentLocale ?? 'es');
---

<Layout title={t['donaciones.title']} description={t['donaciones.subtitle']}>
	<Header />
	<main class="pt-20 md:pt-24 max-w-container-max mx-auto px-4 md:px-gutter">
		<Donate />
	</main>
	<BottomNav />
	<Footer />
</Layout>