---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Identity from '../../components/Identity.astro';
import BottomNav from '../../components/BottomNav.astro';
import Footer from '../../components/Footer.astro';
import { getTranslations } from '../../i18n/ui';

const t = getTranslations('en');
---

<Layout title={t['nosotros.title']} description={t['nosotros.subtitle']}>
	<Header />
	<main class="pt-20 md:pt-24 max-w-container-max mx-auto px-4 md:px-gutter">
		<Identity />
	</main>
	<BottomNav />
	<Footer />
</Layout>