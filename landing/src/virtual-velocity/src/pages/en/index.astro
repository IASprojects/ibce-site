---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import WelcomeBento from '../../components/WelcomeBento.astro';
import BottomNav from '../../components/BottomNav.astro';
import Footer from '../../components/Footer.astro';
import { getTranslations } from '../../i18n/ui';

const t = getTranslations(Astro.currentLocale ?? 'es');
---

<Layout title={t['meta.title']} description={t['meta.description']}>
	<Header />
	<main id="main" tabindex="-1" class="mx-auto max-w-container-max px-4 pt-20 focus:outline-none md:px-gutter md:pt-24">
		<Hero />
		<WelcomeBento />
	</main>
	<BottomNav />
	<Footer />
</Layout>
